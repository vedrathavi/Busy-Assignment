# ==============================================================================
# BUSY CRM Backend - Environment Variables
# ==============================================================================

# Server Runtime Configuration
PORT=5000
NODE_ENV=production

# Database Connection (Supabase PostgreSQL)
# DATABASE_URL: Transaction Pooler URL (port 6543) with ?pgbouncer=true for application queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct Session Connection (port 5432) for running Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Authentication & Security
# Generate a strong 32+ character random string (e.g., openssl rand -base64 32)
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin(s)
# In production, set to your Vercel deployment URL (or comma-separated URLs):
FRONTEND_URL="https://your-frontend-app.vercel.app"
