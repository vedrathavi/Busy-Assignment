# ==============================================================================
# BUSY CRM Frontend - Environment Variables
# ==============================================================================

# API Base URL:
# For local development with local backend: http://localhost:5000/api
# For production or connecting to Render backend: https://your_BACKEND.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Quick Demo Login helper (fills demo credentials on login screen)
VITE_ENABLE_DEMO_LOGIN=true
